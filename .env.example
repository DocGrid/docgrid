# .env.example - 이 파일을 복사해서 .env로 만들고 값을 채우세요
# cp .env.example .env

# PostgreSQL 17 + pgvector 0.8.1 local DB (docker-compose 기본값)
DB_HOST=localhost
DB_PORT=55432
DB_NAME=app
DB_USER=app
DB_PASSWORD=local_password
DB_SCHEMA=public
DB_SSLMODE=disable
SPRING_PROFILES_ACTIVE=local
# 로컬 Hibernate SQL 진단이 필요할 때만 주석 해제합니다.
# JPA_SHOW_SQL=true

# 파일 저장소 - 기본 애플리케이션 값은 local이지만 현재 Docker 개발환경은 MinIO를 명시적으로 사용합니다.
STORAGE_TYPE=minio
STORAGE_BUCKET=docgrid
# STORAGE_TYPE=local일 때만 사용하며 실제 파일은 Git에 포함되지 않습니다.
STORAGE_LOCAL_ROOT=./data/docgrid

# MinIO Adapter (docker-compose 기본값)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin1234

# AWS S3 Adapter를 선택할 때 위 STORAGE_TYPE을 s3로 바꾸고 아래 값을 설정합니다.
# AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# 임시 Credential을 사용할 때만 설정합니다.
# AWS_SESSION_TOKEN=
# AWS S3 기본 Endpoint는 설정하지 않습니다. LocalStack·VPC Endpoint 등에만 사용합니다.
# S3_ENDPOINT=
# S3_PATH_STYLE_ACCESS_ENABLED=false

# 문서 Chunk 정책 - 기본값을 쓰면 설정하지 않아도 됩니다.
# 같은 배포군의 Worker는 결정성을 위해 반드시 같은 값을 사용해야 합니다.
# DOCUMENT_CHUNK_SIZE=1000
# DOCUMENT_CHUNK_OVERLAP=200

# 빈 인덱싱 Queue가 이어질 때 Worker의 DB Polling 간격 상한입니다.
# INDEXING_WORKER_IDLE_MAX_POLLING_INTERVAL=10s
# Provider 장애 뒤 Job Retry가 다시 몰리지 않게 지수 Backoff를 분산하는 비율입니다.
# INDEXING_WORKER_RETRY_JITTER_RATIO=0.2

# 임베딩 서버 - application.yml에 이미 기본값(http://localhost:8000)이 있어 docker-compose 기본 포트를 쓰면 설정 불필요.
# 기본값과 다른 포트/호스트를 쓸 때만 주석 해제
# EMBEDDING_SERVER_URL=http://localhost:8000
# 문서 Batch 기본값은 실제 BGE-M3 CPU Benchmark로 선택한 4이며 환경별 재측정 시에만 조정합니다.
# EMBEDDING_DOCUMENT_BATCH_SIZE=4
# 연속 Provider 장애 3회 뒤 30초 동안 호출을 빠르게 차단합니다.
# EMBEDDING_PROVIDER_CIRCUIT_BREAKER_ENABLED=true
# EMBEDDING_PROVIDER_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
# EMBEDDING_PROVIDER_CIRCUIT_BREAKER_OPEN_DURATION=30s
# 제한 적용 후 Peak RSS 2,694.20 MiB에 30% 이상 여유를 둔 Embedding Container 기본 상한입니다.
# EMBEDDING_CONTAINER_MEMORY_LIMIT=4g
# Docker Desktop 10 vCPU에서 p99 24.07초 이하를 확인했으며 다른 Host에서는 재측정 후 조정합니다.
# EMBEDDING_CONTAINER_CPUS=4.0
# 선택형 monitoring Profile: docker compose --profile monitoring up -d
# Backend 운영 엔드포인트 전용 포트입니다. 외부 인터넷에 직접 공개하지 마세요.
# MANAGEMENT_PORT=8081
# MANAGEMENT_METRICS_SNAPSHOT_INTERVAL=15s
# PROMETHEUS_PORT=9090
# PROMETHEUS_RETENTION=7d
# PROMETHEUS_MEMORY_LIMIT=512m
# PROMETHEUS_CPU_LIMIT=0.5

# 벡터 검색 최소 유사도 - 기본값 0.30을 쓰면 설정하지 않아도 됩니다.
# 검색 품질 평가로 기준을 조정하거나 이전 Top-K 동작을 확인할 때만 변경합니다.
# SEARCH_VECTOR_MIN_SIMILARITY=0.30
# 한 문서가 검색 결과를 독점하면 문서별 청크 상한을 조정합니다. 기본값은 2입니다.
# SEARCH_VECTOR_MAX_CHUNKS_PER_DOCUMENT=2
# 문서 다양성 필터 전 추가 조회할 후보 배수입니다. 기본값은 4입니다.
# SEARCH_VECTOR_CANDIDATE_POOL_MULTIPLIER=4

# Ollama RAG LLM 서버 - application.yml에 이미 기본값(http://localhost:11434)이 있어 docker-compose 기본 포트를 쓰면 설정 불필요.
# 기본값과 다른 포트/호스트를 쓸 때만 주석 해제
# OLLAMA_SERVER_URL=http://localhost:11434
# 백엔드가 프론트의 29초 검색 제한 전에 Fallback을 반환하도록 기본 3초/18초로 정렬되어 있습니다.
# OLLAMA_SERVER_CONNECT_TIMEOUT=3s
# OLLAMA_SERVER_READ_TIMEOUT=18s

# Redis (로그아웃 토큰 블랙리스트) - application.yml에 이미 기본값(localhost:6379, 인증 없음)이 있어
# docker-compose 기본 포트를 쓰면 설정 불필요. 기본값과 다를 때만 주석 해제
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TIMEOUT=1s
