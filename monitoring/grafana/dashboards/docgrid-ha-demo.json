{
  "annotations": {"list": []},
  "description": "GCP OpenSQL HA 시연: k6 HTTP 결과와 앱·Patroni 상태를 같은 시간축에서 본다. OpenProxy 프로세스 상태는 별도 장애 로그에서 확인하고, 정합성은 요청 ID 원장과 DB 대조로 판정한다.",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "서비스와 DB 상태",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "앱 A/B·DB 3대 지표 수집",
      "description": "Prometheus scrape 성공(1)·실패(0). up=1은 실제 HTTP 쓰기 성공을 뜻하지 않는다.",
      "datasource": {"type": "prometheus", "uid": "ha-prometheus"},
      "gridPos": {"x": 0, "y": 1, "w": 12, "h": 7},
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "short"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "up{job=~\"docgrid-app|patroni\"}", "legendFormat": "{{job}} / {{node}}", "datasource": {"type": "prometheus", "uid": "ha-prometheus"}}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Patroni primary 역할",
      "description": "노드별 primary=1·replica=0. 역할 전환은 이 값과 timeline을 함께 확인한다.",
      "datasource": {"type": "prometheus", "uid": "ha-prometheus"},
      "gridPos": {"x": 12, "y": 1, "w": 12, "h": 7},
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "short"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "patroni_primary{job=\"patroni\"}", "legendFormat": "{{node}}", "datasource": {"type": "prometheus", "uid": "ha-prometheus"}}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "앱 Hikari 연결 대기",
      "description": "앱별 Hikari pending 연결 요청 수. DB 전환 중 풀 대기가 쌓이는지 관측한다.",
      "datasource": {"type": "prometheus", "uid": "ha-prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 7},
      "fieldConfig": {"defaults": {"min": 0, "unit": "short"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "hikaricp_connections_pending{job=\"docgrid-app\"}", "legendFormat": "{{node}} / {{pool}}", "datasource": {"type": "prometheus", "uid": "ha-prometheus"}}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "standby 수신 후 WAL 재생 대기",
      "description": "각 standby가 이미 받은 WAL과 재생한 WAL의 차이(Byte). primary와 standby 사이 전체 복제 지연이나 RPO는 이 값만으로 판정할 수 없다.",
      "datasource": {"type": "prometheus", "uid": "ha-prometheus"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 7},
      "fieldConfig": {"defaults": {"min": 0, "unit": "bytes"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "clamp_min(patroni_xlog_received_location{job=\"patroni\"} - patroni_xlog_replayed_location{job=\"patroni\"}, 0) and on(instance) (patroni_replica{job=\"patroni\"} == 1)", "legendFormat": "{{node}}", "datasource": {"type": "prometheus", "uid": "ha-prometheus"}}]
    },
    {
      "id": 6,
      "type": "row",
      "title": "k6 HTTP 결과",
      "collapsed": false,
      "gridPos": {"x": 0, "y": 15, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP 결과별 응답/초",
      "description": "응답이 끝난 시각의 k6 Counter를 30초 창으로 계산한다. timeout·결과 불명은 응답 지연만큼 장애 주입 시각보다 늦게 나타날 수 있다.",
      "datasource": {"type": "prometheus", "uid": "ha-prometheus"},
      "gridPos": {"x": 0, "y": 16, "w": 16, "h": 8},
      "fieldConfig": {"defaults": {"min": 0, "unit": "reqps"}, "overrides": []},
      "targets": [
        {"refId": "A", "expr": "sum(rate(k6_ha_outcome_201_total{run_id=~\"$run_id\"}[30s]))", "legendFormat": "HTTP 201", "datasource": {"type": "prometheus", "uid": "ha-prometheus"}},
        {"refId": "B", "expr": "sum(rate(k6_ha_outcome_500_total{run_id=~\"$run_id\"}[30s]))", "legendFormat": "HTTP 500", "datasource": {"type": "prometheus", "uid": "ha-prometheus"}},
        {"refId": "C", "expr": "sum(rate(k6_ha_outcome_503_total{run_id=~\"$run_id\"}[30s]))", "legendFormat": "HTTP 503", "datasource": {"type": "prometheus", "uid": "ha-prometheus"}},
        {"refId": "D", "expr": "sum(rate(k6_ha_outcome_other_failed_total{run_id=~\"$run_id\"}[30s]))", "legendFormat": "기타 HTTP 실패", "datasource": {"type": "prometheus", "uid": "ha-prometheus"}},
        {"refId": "E", "expr": "sum(rate(k6_ha_outcome_unknown_total{run_id=~\"$run_id\"}[30s]))", "legendFormat": "결과 불명", "datasource": {"type": "prometheus", "uid": "ha-prometheus"}}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "활성 k6 VU",
      "description": "활성 가상 사용자 수. constant-arrival-rate에서 응답 대기 증가의 보조 지표이며, 전송하지 못한 iterations는 별도 k6 원장으로 판정한다.",
      "datasource": {"type": "prometheus", "uid": "ha-prometheus"},
      "gridPos": {"x": 16, "y": 16, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"min": 0, "unit": "short"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "k6_vus{run_id=~\"$run_id\"}", "legendFormat": "VU", "datasource": {"type": "prometheus", "uid": "ha-prometheus"}}]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["opensql", "ha", "test"],
  "templating": {
    "list": [{
      "name": "run_id",
      "label": "실행 ID",
      "type": "query",
      "datasource": {"type": "prometheus", "uid": "ha-prometheus"},
      "definition": "label_values(k6_ha_outcome_201_total, run_id)",
      "query": {"query": "label_values(k6_ha_outcome_201_total, run_id)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
      "includeAll": true,
      "allValue": ".*",
      "current": {"selected": true, "text": "All", "value": "$__all"},
      "options": [],
      "refresh": 1,
      "sort": 1
    }]
  },
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {"refresh_intervals": ["5s", "10s", "30s", "1m"]},
  "timezone": "browser",
  "title": "DocGrid OpenSQL HA Live",
  "uid": "docgrid-opensql-ha-live",
  "version": 1
}
